{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OTCS": {
    "WebUrl": "http://192.168.1.217/otcs/cs.exe/app",
    "ApiUrl": "http://192.168.1.217/otcs/cs.exe/api",
    "Username": "admin",
    "Password": "P@ssw0rd"
  },
  "SharePoint": {
    "SiteUrl": "http://melvinpc/sites/Testt",
    "Username": "administrator",
    "Password": "P@ssw0rd"
  },
  "AllowedHosts": "*",
  "NLog": {
    "internalLogLevel": "Off",
    "internalLogFile": "",
    "autoReload": true,
    "throwConfigExceptions": true,
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "./logs/spcoedit-${shortdate}.log",
        "layout": "${longdate} | ${level:uppercase=true} | ${callsite}(${callsite-linenumber}) | ${message} ${exception:format=StackTrace}"
      },
      "logconsole": {
        "type": "ColoredConsole",
        "layout": "${longdate} | ${level:uppercase=true} | ${logger} | ${message}"
      }
    },
    "rules": [
      {
        "logger": "Microsoft.*",
        "maxLevel": "Fatal",
        "final": true
      },
      {
        "logger": "System.*",
        "maxLevel": "Fatal",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "logfile,logconsole"
      }
    ]
  }
}
